<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_Citas_Medicas.Views.MainPage"
             Title="Registro"
             Shell.BackgroundColor="#cadaeb">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            Margin="10">
            <Image                
                Source="login.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="imagen de registro" />

            <Label
                Text="¡Bienvenido!"
                HorizontalOptions="Center"
                FontSize="40"/>

            <Label
                Text="Ingrese sus credenciales para continuar"
                HorizontalTextAlignment="Center"
                FontSize="27" />

            <Entry Placeholder="Correo electronico"
                   FontSize="20"/>
            
            <Entry Placeholder="Contraseña"
                   FontSize="20"/>

            <Button           
                x:Name="LoginBtn"           
                Text="Iniciar sesión"            
                FontAttributes="Bold"           
                FontSize="18"           
                TextColor="Black"           
                BackgroundColor="#e8ebed"           
                HorizontalOptions="Fill"            
                Clicked="loginBtn"/>

            <StackLayout 
                Orientation="Horizontal"
                HorizontalOptions="Center"
                Margin="0,10,0,0">
                <Label 
                    Text="¿No está registrado?"
                    FontSize="18"/>
                <Label 
                    Text=" Regístrese aquí"
                    FontSize="18"              
                    TextColor="Blue">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="IrRegistro" />
                    </Label.GestureRecognizers>
                </Label>

            </StackLayout>

        </VerticalStackLayout>
    </ScrollView>
    

</ContentPage>
