<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_Citas_Medicas.Views.Doctores"
             Title="Doctores"
             Shell.BackgroundColor="#cadaeb">
 
        <CollectionView x:Name="collectionViewEspecialidades"
                       ItemsSource="{Binding doctores}"
                       IsGrouped="True">
            
        <CollectionView.GroupHeaderTemplate>
            <DataTemplate>
                <Border Stroke="Black"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 40" 
                            Margin="10,10,10,10">
                    <Label Text="Fechas disponibles" 
                           FontSize="30" 
                           FontAttributes="Bold" 
                           TextColor="black"
                           BackgroundColor="#f7f6dc"
                           Padding="10"
                           HorizontalTextAlignment="Center"/>
                </Border>
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.ItemTemplate>
                <DataTemplate>
                <Border Stroke="Black"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Margin="7,5,7,20"
                        BackgroundColor="#e8ebed">
                    <Grid ColumnDefinitions="140, *" 
                          ColumnSpacing="5" 
                          Padding="5">
                        <VerticalStackLayout Grid.Column="0" 
                                                 Spacing="1" 
                                                 VerticalOptions="Center" 
                                                 HorizontalOptions="Center">
                            <Label Text="{Binding Especialidad}"                                       
                                   FontSize="15"
                                   TextColor="Black"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"/>
                                <Image Source="{Binding Imagen}"            
                                       WidthRequest="60"                                    
                                       HeightRequest="60" />
                                <Label Text="{Binding Nombre}"                                                                            
                                       FontSize="20"                                     
                                       TextColor="Black"                                     
                                       FontAttributes="Bold" 
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" 
                                                 Spacing="1" 
                                                 VerticalOptions="Center" 
                                                 HorizontalOptions="Center">
                                <Label Text="{Binding DiasConsultas}"                                                                        
                                       FontSize="20"                                     
                                       TextColor="Black"                                     
                                       FontAttributes="Bold" 
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="{Binding Horario}"                                                     
                                       FontSize="15"                           
                                       TextColor="Black"                           
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"/>
                                <Button Text="Ver detalles"            
                                        FontSize="15"
                                        WidthRequest="150"
                                        HeightRequest="40"
                                        Background="Gray"
                                        Clicked="RealizarCitas"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
</ContentPage>